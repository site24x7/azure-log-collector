# ============================================================
# Azure Diagnostic Logs Collection — Configuration
# ============================================================
# SETUP:
#   1. Copy this file:  cp config.env.example config.env
#   2. Fill in the values below
#   3. Run:  bash setup.sh
#
# To find your subscription IDs, run:
#   az account list --query '[].{Name:name, ID:id}' -o table
# ============================================================

# Required ────────────────────────────────────────────────────

# Comma-separated Azure subscription IDs to monitor
# Example: "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
# Multiple: "sub-id-1,sub-id-2"
SUBSCRIPTION_IDS="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Site24x7 Device Key for AppLogs integration (required; no stub mode)
SITE24X7_API_KEY="your-device-key-here"

# Site24x7 data center domain — determines where logs are sent.
# US: site24x7.com | IN: site24x7.in | EU: site24x7.eu
# AU: site24x7.net.au | CN: site24x7.cn | JP: site24x7.jp
SITE24X7_DOMAIN="site24x7.com"

# Optional (defaults shown) ───────────────────────────────────

# Resource group name (will be created if it doesn't exist)
# Empty: s247-diag-logs-<DEPLOYMENT_SUFFIX>-rg, or s247-diag-logs-rg without a suffix.
# Set it to redeploy an existing collector in its current resource group.
RESOURCE_GROUP_NAME=""

# Optional naming override for a FRESH installation. Use 12–13 lowercase
# letters/digits to reduce global name collisions; keep it for all updates.
# Leave blank for existing deployments to preserve their current names.
# Do not change the suffix of a live deployment or run multiple collectors
# in the same resource group.
DEPLOYMENT_SUFFIX=""

# Function App name — MUST be globally unique across all of Azure!
# Leave blank to use the subscription-derived suffix or DEPLOYMENT_SUFFIX;
# the resulting name still must be globally available.
# Example: "s247-diag-func-myteam"
FUNCTION_APP_NAME=""

# Storage account name — MUST be globally unique, lowercase, no hyphens, 3-24 chars
# Leave blank to use the subscription-derived suffix or DEPLOYMENT_SUFFIX;
# the resulting name still must be globally available.
# Example: "s247diagmyteam"
STORAGE_ACCOUNT_NAME=""

# Azure region for the Function App and Storage Account
# (log storage accounts are auto-created in each region where resources exist)
FUNCTION_APP_REGION="eastus"

# How often to scan for new resources (Azure Functions CRON format)
# Default: every 6 hours
TIMER_SCHEDULE="0 0 */6 * * *"

# Enable the general catch-all log type for unsupported categories
GENERAL_LOGTYPE_ENABLED="true"

# Update source — owner/repo shorthand or a supported HTTPS version.json URL.
# When configured, the Function App checks daily at 3 AM UTC for new versions.
# Automatic installs default to false; admins use Update Collector in Site24x7.
# AUTO_UPDATE_ENABLED=true enables timer installs; leave this URL blank to disable checks.
#
# The package must belong to the configured repository; SHA-256 is required by default.
# The version.json format:
# {
#   "version": "1.1.0",
#   "package_url": "https://github.com/site24x7/azure-log-collector/releases/download/v1.1.0/released-package.zip",
#   "sha256": "<64-character SHA-256 digest of the release package>",
#   "release_notes": "Description of changes"
# }
UPDATE_CHECK_URL=""
