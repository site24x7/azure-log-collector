{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "type": "timerTrigger",
      "name": "timer",
      "direction": "in",
      "schedule": "0 */2 * * * *"
    },
    {
      "type": "queue",
      "name": "scanQueue",
      "direction": "out",
      "queueName": "scan-requests",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
